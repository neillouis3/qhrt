# Supabase Configuration
# Replace these with your actual Supabase project values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-secret-key-here

# App origin (CSRF checks + password-reset redirect target). Leave unset to auto-derive from the request.
# Set this to your production URL in deployed environments.
# NEXT_PUBLIC_APP_ORIGIN=https://app.example.com
#
# Supabase Auth (Dashboard → Authentication → URL Configuration):
#   Site URL: same as NEXT_PUBLIC_APP_ORIGIN (or http://localhost:3000 locally)
#   Redirect URLs: http://localhost:3000/reset-password and https://your-domain/reset-password
# Password reset emails use redirectTo = {NEXT_PUBLIC_APP_ORIGIN or request origin}/reset-password

# Rate limiting (Upstash Ratelimit + Upstash Redis). Optional — when unset, an
# in-memory fallback is used (single-process only; fine for local development).
# UPSTASH_REDIS_REST_URL=redis://...
# UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Canada access gate. Requests from CA (Vercel x-vercel-ip-country / Cloudflare
# CF-IPCountry) see /unavailable until this code is entered. Required in
# production so the team can still open the site from Canada. Never prefix with
# NEXT_PUBLIC_ (it must stay server-only).
# GEO_ACCESS_CODE=a-long-random-phrase
#
# Local preview of the Canada screen (leave unset in normal development):
# GEO_FORCE_COUNTRY=CA

# ElevenLabs voiceover for module introductions. Without a key, slides still
# play using the browser's speech. Never prefix with NEXT_PUBLIC_.
# ELEVENLABS_API_KEY=
# Optional voice id (defaults to a calm English voice):
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL